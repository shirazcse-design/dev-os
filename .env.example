# ==============================================================================
# ContractIQ — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ==============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ORG_ID=

# --- App configuration --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Upload / processing limits (mirrors PRD constraints — override only if re-tuning) ---
MAX_UPLOAD_SIZE_MB=10
MAX_PAGE_COUNT=20
MAX_CONTRACT_TOKENS=15000
MAX_CUSTOM_TERMS=5
MAX_CHAT_HISTORY=100

# --- Rate limiting ---------------------------------------------------------------
# Fixed policy constants, not env-tunable — see lib/security/rateLimiter.ts and
# docs/security/security-plan.md.

# --- Monitoring (optional, referenced in PRD §11 "How is system health monitored") ---
UPTIME_ROBOT_API_KEY=
